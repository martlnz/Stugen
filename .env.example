# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env

# ---------- Chung ----------
DOMAIN=localhost
APP_URL=http://localhost

# ---------- PostgreSQL ----------
POSTGRES_USER=stugen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stugen
DATABASE_URL=postgresql+asyncpg://stugen:change-me@postgres:5432/stugen
DATABASE_URL_SYNC=postgresql+psycopg://stugen:change-me@postgres:5432/stugen

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://minio:9000
S3_BUCKET=stugen

# ---------- Google OAuth (Google Cloud Console → Credentials → OAuth client ID) ----------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
OAUTH_REDIRECT_URI=http://localhost/api/auth/google/callback

# ---------- Phiên đăng nhập ----------
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---------- LLM (chỉ backend/worker đọc) ----------
# anthropic | openai | openai_compatible (DeepSeek, Ollama, ...)
# Mặc định: DeepSeek (ADR-0016). Lấy key tại https://platform.deepseek.com
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-v4-pro
LLM_MODEL_FAST=deepseek-flash
LLM_API_KEY=sk-xxxxxxxx
# Chỉ cần cho openai_compatible. Ollama: http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.deepseek.com
LLM_MAX_CONCURRENCY=4
# Ngôn ngữ nội dung sinh ra: vi (tiếng Việt, giữ thuật ngữ gốc) | source (theo ngôn ngữ tài liệu)
CONTENT_LANGUAGE=vi

# ---------- Giới hạn ----------
MAX_UPLOAD_MB=20
MAX_PAGES=200
CELERY_CONCURRENCY=2
